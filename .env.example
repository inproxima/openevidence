# Copy to .env and fill in. Never commit .env.

APP_NAME=Clinical Evidence CA
REGION_FOCUS=CA

# --- OpenAI (required) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium   # Quick answers
OPENAI_FAST_EFFORT=low           # planning, reranking, follow-ups, image reading
OPENAI_DEEP_EFFORT=high          # Deep answers

# --- Canadian guideline web search: engines run in parallel ---
# openai  = OpenAI hosted web search (one billed web-search call per question; finds guideline PDFs/chapters)
# serpapi = SerpAPI Google search (5 searches per question)
GUIDELINE_SEARCH=openai,serpapi
SERPAPI_API_KEY=

# --- NCBI E-utilities for PubMed (optional, free; raises the limit from 3 to 10 requests/s) ---
# ncbi.nlm.nih.gov -> sign in -> Account settings -> API Key Management -> Create
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=clinical-evidence-ca

# --- Retrieval sizes ---
MAX_SOURCES_QUICK=12
MAX_SOURCES_DEEP=40

# --- Database: blank = SQLite at data/app.db; postgres:// or postgresql:// URL when deployed ---
DATABASE_URL=

# --- Auth0 login for testers (leave AUTH0_DOMAIN blank to turn auth off) ---
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

CORS_ORIGINS=http://localhost:5173

# true = canned model output (real searches) for UI testing without an OpenAI key
LLM_MOCK=false
